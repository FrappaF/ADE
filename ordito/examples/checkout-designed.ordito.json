{
	"version": 3,
	"id": "purchase-design",
	"name": "Checkout Design",
	"semantics": {
		"elements": [
			{
				"id": "purchase",
				"kind": "feature",
				"name": "Confirm Purchase"
			},
			{
				"id": "customer",
				"kind": "actor",
				"name": "Customer",
				"parentId": "purchase"
			},
			{
				"id": "checkout",
				"kind": "view",
				"name": "Checkout",
				"parentId": "purchase"
			},
			{
				"id": "controller",
				"kind": "controller",
				"name": "Confirm Order",
				"parentId": "purchase"
			},
			{
				"id": "order",
				"kind": "resource",
				"name": "Order",
				"parentId": "purchase"
			},
			{
				"id": "payment",
				"kind": "action",
				"name": "Request Payment",
				"parentId": "purchase",
				"behavior": {
					"inputs": [{ "name": "amount", "type": "Money", "required": true }],
					"outputs": [{ "name": "receipt", "type": "PaymentReceipt", "required": false }],
					"preconditions": ["The amount is positive"],
					"postconditions": ["An authorized payment confirms at most one order"],
					"errors": [{ "code": "payment-declined", "description": "Payment declined: no order was confirmed" }],
					"permissions": [],
					"acceptanceCriteria": []
				}
			},
			{
				"id": "confirmed",
				"kind": "action",
				"name": "Order Confirmed",
				"parentId": "purchase"
			},
			{
				"id": "declined",
				"kind": "action",
				"name": "Payment Declined",
				"parentId": "purchase"
			},
			{
				"id": "order-awaiting",
				"kind": "state",
				"name": "Pending",
				"parentId": "order",
				"behavior": {
					"inputs": [], "outputs": [], "preconditions": [], "postconditions": [],
					"errors": [{ "code": "payment-declined", "description": "Payment not authorized" }],
					"permissions": [], "acceptanceCriteria": []
				}
			},
			{ "id": "order-confirmed", "kind": "state", "name": "Confirmed", "parentId": "order" },
			{ "id": "order-declined", "kind": "state", "name": "Payment Declined", "parentId": "order" }
		],
		"relations": [
			{
				"id": "customer-checkout",
				"kind": "invocation",
				"from": "customer",
				"to": "checkout",
				"name": "confirms purchase"
			},
			{
				"id": "checkout-controller",
				"kind": "invocation",
				"from": "checkout",
				"to": "controller",
				"name": "submits"
			},
			{
				"id": "controller-order",
				"kind": "write",
				"from": "controller",
				"to": "order",
				"name": "creates order",
				"condition": "payment authorized"
			},
			{
				"id": "payment-success",
				"kind": "invocation",
				"from": "payment",
				"to": "confirmed",
				"name": "confirms order",
				"condition": "payment authorized"
			},
			{
				"id": "payment-declined",
				"kind": "invocation",
				"from": "payment",
				"to": "declined",
				"name": "shows error",
				"condition": "payment declined",
				"errorCode": "payment-declined"
			},
			{
				"id": "order-payment-accepted", "kind": "transition", "from": "order-awaiting", "to": "order-confirmed",
				"name": "Confirm Payment", "condition": "payment authorized"
			},
			{
				"id": "order-payment-refused", "kind": "transition", "from": "order-awaiting", "to": "order-declined",
				"name": "Decline Payment", "condition": "payment not authorized", "errorCode": "payment-declined"
			}
		]
	},
	"views": [
		{
			"id": "structure",
			"name": "Checkout Structure",
			"kind": "structure",
			"featureId": "purchase",
			"nodes": [
				{
					"elementId": "customer",
					"x": 0,
					"y": 0
				},
				{
					"elementId": "checkout",
					"x": 260,
					"y": 0
				},
				{
					"elementId": "controller",
					"x": 520,
					"y": 0
				},
				{
					"elementId": "order",
					"x": 0,
					"y": 180
				}
			],
			"relationIds": [
				"customer-checkout",
				"checkout-controller",
				"controller-order"
			]
		},
		{
			"id": "flow",
			"name": "Checkout Flow",
			"kind": "activity",
			"featureId": "purchase",
			"nodes": [
				{
					"elementId": "payment",
					"x": 0,
					"y": 0
				},
				{
					"elementId": "confirmed",
					"x": 260,
					"y": 0
				},
				{
					"elementId": "declined",
					"x": 520,
					"y": 0
				}
			],
			"relationIds": [
				"payment-success",
				"payment-declined"
			]
		},
		{
			"id": "payment-sequence",
			"name": "Payment Sequence",
			"kind": "sequence",
			"featureId": "purchase",
			"nodes": [
				{ "elementId": "payment", "x": 0, "y": 0 },
				{ "elementId": "confirmed", "x": 260, "y": 0 },
				{ "elementId": "declined", "x": 520, "y": 0 }
			],
			"relationIds": ["payment-success", "payment-declined"]
		},
		{
			"id": "order-states", "name": "Order States", "kind": "state", "featureId": "purchase",
			"nodes": [
				{ "elementId": "order", "x": 0, "y": 0 },
				{ "elementId": "order-awaiting", "x": 260, "y": 0 },
				{ "elementId": "order-confirmed", "x": 520, "y": 0 },
				{ "elementId": "order-declined", "x": 260, "y": 180 }
			],
			"relationIds": ["order-payment-accepted", "order-payment-refused"]
		}
	],
	"codeMappings": [],
	"verifications": []
}
