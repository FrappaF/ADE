{
	"version": 3,
	"id": "observatory-system",
	"name": "Observatory — α Centauri",
	"semantics": {
		"elements": [
			{
				"id": "feature",
				"kind": "feature",
				"name": "Nighttime Observations"
			},
			{
				"id": "agent",
				"kind": "actor",
				"name": "Astronomer"
			},
			{
				"id": "worker",
				"kind": "component",
				"name": "Coordinator",
				"parentId": "feature"
			},
			{
				"id": "scheduler",
				"kind": "action",
				"name": "Schedule Observation",
				"parentId": "worker"
			},
			{
				"id": "resource",
				"kind": "resource",
				"name": "Exposure",
				"parentId": "worker"
			},
			{
				"id": "contract",
				"kind": "contract",
				"name": "Optical Constraints"
			},
			{
				"id": "idle",
				"kind": "state",
				"name": "Queued",
				"parentId": "resource"
			},
			{
				"id": "active",
				"kind": "state",
				"name": "Captured",
				"parentId": "resource"
			},
			{
				"id": "isolated",
				"kind": "resource",
				"name": "Exposure"
			}
		],
		"relations": [
			{
				"id": "request",
				"kind": "invocation",
				"from": "agent",
				"to": "scheduler",
				"name": "Books Session"
			},
			{
				"id": "constraints",
				"kind": "dependency",
				"from": "scheduler",
				"to": "contract",
				"name": "Checks Constraints"
			},
			{
				"id": "write",
				"kind": "write",
				"from": "scheduler",
				"to": "resource",
				"name": "Records Image"
			},
			{
				"id": "feedback",
				"kind": "dependency",
				"from": "worker",
				"to": "scheduler",
				"name": "Starts Scheduling"
			},
			{
				"id": "cycle",
				"kind": "dependency",
				"from": "scheduler",
				"to": "worker",
				"name": "Consults Coordinator"
			},
			{
				"id": "capture",
				"kind": "transition",
				"from": "idle",
				"to": "active",
				"name": "Exposure Complete",
				"condition": "Sufficient signal"
			}
		]
	},
	"views": [],
	"codeMappings": [],
	"verifications": []
}
