{
	"compilerOptions": {
		"target": "ES2024",
		"module": "NodeNext",
		"strict": true,
		"noEmit": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"allowImportingTsExtensions": true,
		"erasableSyntaxOnly": true,
		"types": ["node"],
		"skipLibCheck": true
	},
	"include": ["*.ts"]
}
