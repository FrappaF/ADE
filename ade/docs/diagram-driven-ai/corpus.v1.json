{
	"version": 1,
	"id": "dai-acceptance-v1",
	"purpose": "Authored inputs and independent expected observations, frozen before any DAI generation. This is a test specification, not SemanticModel v4 or generated application code.",
	"executionStatus": "pending-adapters",
	"oracle": {
		"owner": "quality",
		"comparison": "Deep equality of normalized observations, preserving array order. Unordered concurrent effects must be sorted by stable ID by the trusted observer, never by the generated implementation.",
		"source": "Read-only release fixture, excluded from generated patches and generated tests. Observe actual return values, persisted rows, calls and traces through a trusted adapter; never accept a provider's assertion that tests passed.",
		"money": "Integer minor units, EUR; no floating point conversion. Stock reservations are released on a declined payment; an ambiguous timeout retains the reservation and requires reconciliation, with no automatic second charge.",
		"identity": "Requests, orders, events, operations and occurrences have explicit IDs. Duplicate request/event IDs must not duplicate business effects.",
		"trace": "Strings identify observed boundary calls in order. Effects not listed in expected observations are forbidden for that case.",
		"blocked": "A generation/readiness rejection preserves the draft and performs zero provider calls and zero writes unless the case explicitly describes a later review/apply rejection. Diagnostic codes here are oracle categories, not existing ADE API codes.",
		"qualification": "Each mandatory case must pass on each declared archetype. Harness validation, recorded outputs, local domain tests, live inference and desktop observations remain separate evidence classes."
	},
	"cases": [
