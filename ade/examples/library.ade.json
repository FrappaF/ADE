{
	"version": 3,
	"id": "library-system",
	"name": "Biblioteca civica",
	"semantics": {
		"elements": [
			{
				"id": "feature",
				"kind": "feature",
				"name": "Prestiti"
			},
			{
				"id": "catalog",
				"kind": "feature",
				"name": "Catalogo"
			},
			{
				"id": "agent",
				"kind": "actor",
				"name": "Bibliotecaria"
			},
			{
				"id": "interface",
				"kind": "view",
				"name": "Sportello",
				"parentId": "feature"
			},
			{
				"id": "worker",
				"kind": "controller",
				"name": "Gestore prestiti",
				"parentId": "feature",
				"behavior": {
					"inputs": [
						{
							"name": "isbn",
							"type": "ISBN",
							"required": true
						}
					],
					"outputs": [],
					"preconditions": [
						"Tessera attiva"
					],
					"postconditions": [
						"Un solo prestito attivo per copia"
					],
					"errors": [
						{
							"code": "unavailable",
							"description": "Copia non disponibile"
						}
					],
					"permissions": [
						{
							"actorId": "agent",
							"capability": "loans:manage"
						}
					],
					"acceptanceCriteria": [
						{
							"id": "loan-recorded",
							"given": "Copia disponibile",
							"when": "Richiesta approvata",
							"then": "Prestito registrato"
						}
					]
				}
			},
			{
				"id": "catalog-service",
				"kind": "component",
				"name": "Indice bibliografico",
				"parentId": "catalog"
			},
			{
				"id": "resource",
				"kind": "resource",
				"name": "Copia",
				"parentId": "catalog-service"
			},
			{
				"id": "member",
				"kind": "resource",
				"name": "Tessera",
				"parentId": "catalog"
			},
			{
				"id": "contract",
				"kind": "contract",
				"name": "Regole del prestito",
				"parentId": "feature"
			},
			{
				"id": "idle",
				"kind": "state",
				"name": "Disponibile",
				"parentId": "resource"
			},
			{
				"id": "active",
				"kind": "state",
				"name": "In prestito",
				"parentId": "resource"
			},
			{
				"id": "registered",
				"kind": "state",
				"name": "Attiva",
				"parentId": "member"
			}
		],
		"relations": [
			{
				"id": "request",
				"kind": "invocation",
				"from": "agent",
				"to": "interface",
				"name": "Registra prestito"
			},
			{
				"id": "dispatch",
				"kind": "invocation",
				"from": "interface",
				"to": "worker",
				"name": "Valuta richiesta"
			},
			{
				"id": "update",
				"kind": "write",
				"from": "worker",
				"to": "resource",
				"name": "Assegna copia",
				"condition": "Copia disponibile"
			},
			{
				"id": "policy",
				"kind": "dependency",
				"from": "worker",
				"to": "contract",
				"name": "Applica regole"
			},
			{
				"id": "index",
				"kind": "read",
				"from": "catalog-service",
				"to": "resource",
				"name": "Indicizza copia"
			},
			{
				"id": "lend-copy",
				"kind": "transition",
				"from": "idle",
				"to": "active",
				"name": "Consegna",
				"condition": "Prestito approvato"
			},
			{
				"id": "return-copy",
				"kind": "transition",
				"from": "active",
				"to": "idle",
				"name": "Restituzione"
			}
		]
	},
	"views": [
		{
			"id": "structure",
			"kind": "structure",
			"name": "Servizio prestiti",
			"featureId": "feature",
			"nodes": [
				{
					"elementId": "agent",
					"x": 0,
					"y": 0
				},
				{
					"elementId": "interface",
					"x": 260,
					"y": 0
				},
				{
					"elementId": "worker",
					"x": 520,
					"y": 0
				},
				{
					"elementId": "resource",
					"x": 520,
					"y": 180
				}
			],
			"relationIds": [
				"request",
				"dispatch",
				"update"
			]
		},
		{
			"id": "states",
			"kind": "state",
			"name": "Stati della copia",
			"featureId": "catalog",
			"nodes": [
				{
					"elementId": "resource",
					"x": 0,
					"y": 0
				},
				{
					"elementId": "idle",
					"x": 260,
					"y": 0
				},
				{
					"elementId": "active",
					"x": 520,
					"y": 0
				}
			],
			"relationIds": [
				"lend-copy",
				"return-copy"
			]
		},
		{
			"id": "empty",
			"kind": "activity",
			"name": "Revisione catalogo",
			"featureId": "catalog",
			"nodes": [],
			"relationIds": []
		}
	],
	"codeMappings": [],
	"verifications": []
}
